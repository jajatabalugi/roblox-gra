    <Item class="ModuleScript" referent="RBX000004CC">
      <Properties>
        <string name="Name">WolfConfig</string>
        <ProtectedString name="Source">-- WOLF STREET TYCOON | Shared presentation and server-owned balance.
local Config = {}
Config.Version = 1
Config.Name = "WOLF STREET TYCOON"
Config.BaseIncome = 3
Config.PitchCooldown = 5
Config.ComboWindow = 9
Config.MaxCombo = 5
Config.PrestigeBonus = 0.25
Config.MaxPrestige = 100
Config.EventDuration = 90
Config.SaveInterval = 60
Config.SessionLease = 180
Config.DailyCooldown = 20 * 60 * 60
Config.Upgrades = {
    {name="Telefon maklera", price=140, income=3, floor=1, desc="Pierwsze rozmowy. Pierwsze wielkie plany."},
    {name="Pierwszy stażysta", price=300, income=4, floor=1, desc="Ktoś wreszcie odbiera drugi telefon."},
    {name="Terminal giełdowy", price=500, income=5, floor=1, desc="Dane w czasie rzeczywistym. Przewaga na starcie."},
    {name="Kącik kawowy", price=950, income=6, floor=1, desc="Espresso napędza ten parkiet."},
    {name="Analityk", price=1500, income=8, floor=1, desc="Mniej domysłów, więcej dobrych decyzji."},
    {name="Agencja brokerska", price=2400, income=10, floor=1, desc="Twoje nazwisko zaczyna coś znaczyć."},
    {name="Piętro traderów", price=3600, income=14, floor=2, desc="NOWE PIĘTRO! Winda już czeka."},
    {name="Zespół brokerów", price=5200, income=18, floor=2, desc="Zespół, który potrafi domknąć każdą rozmowę."},
    {name="Serwerownia", price=7500, income=24, floor=2, desc="Więcej mocy obliczeniowej. Więcej okazji."},
    {name="Laboratorium rynku", price=10750, income=32, floor=2, desc="Tutaj trendy stają się strategią."},
    {name="Sala strategii", price=15000, income=44, floor=2, desc="Wielkie decyzje potrzebują wielkiego stołu."},
    {name="Partner zarządzający", price=21500, income=60, floor=2, desc="Firma działa już jak dobrze naoliwiona maszyna."},
    {name="Piętro zarządu", price=31000, income=80, floor=3, desc="NOWE PIĘTRO! Czas wejść na sam szczyt."},
    {name="Globalny zespół", price=44000, income=110, floor=3, desc="Od otwarcia w Tokio po zamknięcie w Nowym Jorku."},
    {name="Terminale premium", price=62000, income=150, floor=3, desc="Najlepsze narzędzia dla najlepszych ludzi."},
    {name="Fundusz inwestycyjny", price=88000, income=200, floor=3, desc="Twoja firma gra już w innej lidze."},
    {name="Penthouse", price=125000, income=275, floor=3, desc="Panorama miasta i biuro godne prezesa."},
    {name="Złoty Wilk", price=176000, income=375, floor=3, desc="Symbol imperium. Odblokowuje PRESTIŻ."},
}
Config.Quests = {
    {title="Domknij 3 kontrakty", stat="contracts", goal=3, reward=45},
    {title="Zatrudnij pierwszego stażystę", stat="highestLevel", goal=2, reward=90},
    {title="Domknij 15 kontraktów", stat="contracts", goal=15, reward=200},
    {title="Otwórz agencję brokerską", stat="highestLevel", goal=6, reward=450},
    {title="Dopasuj strategię do 2 wydarzeń", stat="strategies", goal=2, reward=650},
    {title="Zbuduj laboratorium rynku", stat="highestLevel", goal=10, reward=1400},
    {title="Domknij 80 kontraktów", stat="contracts", goal=80, reward=2200},
    {title="Otwórz piętro zarządu", stat="highestLevel", goal=13, reward=3500},
    {title="Zdobądź Złotego Wilka", stat="highestLevel", goal=18, reward=8500},
    {title="Zbuduj nowe imperium: pierwszy prestiż", stat="prestige", goal=1, reward=1000},
}
Config.Strategies = {
    {id="growth", label="Ekspansja", description="Wzrost i nowi klienci"},
    {id="research", label="Analiza", description="Dane i technologia"},
    {id="relations", label="Relacje", description="Zaufanie i partnerzy"},
}
Config.Events = {
    {title="BOOM TECHNOLOGICZNY", description="Firmy technologiczne szukają analityków. Postaw na dane i badania.", best="research", ticker="BYTE"},
    {title="NOWE RYNKI", description="Miasto otwiera nową dzielnicę biznesową. To dobry moment na ekspansję.", best="growth", ticker="NOVA"},
    {title="TYDZIEŃ PARTNERÓW", description="Duże firmy szukają zaufanych doradców. Zainwestuj w relacje.", best="relations", ticker="LINK"},
    {title="ERA AUTOMATYZACJI", description="Szybkie serwery i trafne dane dają przewagę. Wybierz analizę rynku.", best="research", ticker="BYTE"},
    {title="GLOBALNE OTWARCIE", description="Nowe zagraniczne biura czekają na klientów. Wykorzystaj ekspansję.", best="growth", ticker="NOVA"},
    {title="PRESTIŻOWY KONGRES", description="Najwięksi prezesi spotykają się w mieście. Liczą się relacje.", best="relations", ticker="LINK"},
}
function Config.Format(value)
    if value &gt;= 1e9 then return string.format("%.2f mld", value / 1e9) end
    if value &gt;= 1e6 then return string.format("%.2f mln", value / 1e6) end
    if value &gt;= 1e3 then return string.format("%.1f tys.", value / 1e3) end
    return tostring(math.floor(value))
end
return Config
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX000004C8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX000004CD">
      <Properties>
        <string name="Name">Economy</string>
        <ProtectedString name="Source">-- Pure economy functions. No client-provided prices or rewards are trusted.
local Economy = {}
local Config
local function integer(value, default, maximum)
    if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return default end
    return math.floor(math.max(0, math.min(value, maximum)))
end
function Economy.Init(config) Config = config end
function Economy.New()
    return {cash=0, level=0, prestige=0, contracts=0, highestLevel=0, strategies=0, quest=1, lastDaily=0, totalEarned=0}
end
function Economy.Sanitize(raw)
    local d = Economy.New()
    if type(raw) ~= "table" then return d end
    for _, key in ipairs({"cash", "contracts", "strategies", "totalEarned"}) do
        d[key] = integer(raw[key], d[key], 1e15)
    end
    d.level = integer(raw.level, 0, #Config.Upgrades)
    d.prestige = integer(raw.prestige, 0, Config.MaxPrestige)
    d.highestLevel = math.max(d.level, integer(raw.highestLevel, 0, #Config.Upgrades))
    d.quest = math.max(1, integer(raw.quest, 1, #Config.Quests + 1))
    d.lastDaily = integer(raw.lastDaily, 0, 1e12)
    return d
end
function Economy.BaseIncome(d)
    local sum = Config.BaseIncome
    for index=1,d.level do sum = sum + Config.Upgrades[index].income end
    return sum
end
function Economy.Multiplier(d) return 1 + d.prestige * Config.PrestigeBonus end
function Economy.EventMultiplier(choice, best)
    if choice and choice == best then return 1.35 end
    if choice then return 1.1 end
    return 1
end
function Economy.Income(d, choice, best)
    return Economy.BaseIncome(d) * Economy.Multiplier(d) * Economy.EventMultiplier(choice,best)
end
function Economy.PitchReward(d, combo, choice, best)
    return math.floor(math.max(20, Economy.BaseIncome(d)*2) * Economy.Multiplier(d)
        * (1 + math.min(Config.MaxCombo, math.max(0,combo))*0.06) * Economy.EventMultiplier(choice,best))
end
function Economy.Earn(d, amount)
    amount = math.max(0, math.min(1e12, amount))
    d.cash = math.min(1e15, d.cash + amount)
    d.totalEarned = math.min(1e15, d.totalEarned + amount)
end
function Economy.Buy(d)
    local upgrade = Config.Upgrades[d.level+1]
    if not upgrade then return false, "Twoje imperium jest kompletne. Odblokowano prestiż!" end
    if d.cash &lt; upgrade.price then return false, "Brakuje $"..Config.Format(upgrade.price - d.cash).." do ulepszenia." end
    d.cash = d.cash - upgrade.price
    d.level = d.level + 1
    d.highestLevel = math.max(d.highestLevel, d.level)
    return true, upgrade.name
end
function Economy.Quest(d)
    local q = Config.Quests[d.quest]
    if not q then return nil end
    local progress = math.min(q.goal, d[q.stat] or 0)
    return {title=q.title, progress=progress, goal=q.goal, reward=q.reward, ready=progress&gt;=q.goal}
end
function Economy.ClaimQuest(d)
    local q = Economy.Quest(d)
    if not q or not q.ready then return false end
    Economy.Earn(d, q.reward)
    d.quest = d.quest + 1
    return true, q.reward
end
function Economy.DailyReward(d)
    return math.floor(math.max(100, Economy.BaseIncome(d)*20) * Economy.Multiplier(d))
end
function Economy.ClaimDaily(d, unixTime)
    if unixTime - d.lastDaily &lt; Config.DailyCooldown then return false end
    local reward = Economy.DailyReward(d)
    Economy.Earn(d, reward)
    d.lastDaily = unixTime
    return true, reward
end
function Economy.Prestige(d)
    if d.level &lt; #Config.Upgrades then return false, "Najpierw zbuduj Złotego Wilka (18/18)." end
    if d.prestige &gt;= Config.MaxPrestige then return false, "Osiągnięto najwyższy prestiż!" end
    d.prestige = d.prestige + 1
    d.cash = 0
    d.level = 0
    return true
end
function Economy.Title(d)
    if d.prestige &gt; 0 then return "WILK WALL STREET · "..d.prestige end
    if d.level &gt;= 13 then return "PREZES" end
    if d.level &gt;= 7 then return "PARTNER" end
    if d.level &gt;= 2 then return "MAKLER" end
    return "STAŻYSTA"
end
return Economy
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000004CE">
      <Properties>
        <string name="Name">World</string>
        <ProtectedString name="Source">-- WOLF STREET | Procedural world. All assets are built in Studio at runtime.
local World = {}
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local config, onAction, root, marketLabel
local plots, owners = {}, {}
local C = {
    ink = Color3.fromRGB(12, 19, 32), navy = Color3.fromRGB(24, 35, 53),
    stone = Color3.fromRGB(49, 61, 76), glass = Color3.fromRGB(85, 133, 160),
    white = Color3.fromRGB(225, 237, 245), gold = Color3.fromRGB(255, 197, 77),
    road = Color3.fromRGB(24, 29, 38), green = Color3.fromRGB(74, 239, 169),
}
local accents = {
    Color3.fromRGB(67, 234, 183), Color3.fromRGB(91, 180, 255),
    Color3.fromRGB(191, 129, 255), Color3.fromRGB(255, 191, 83),
    Color3.fromRGB(255, 117, 156), Color3.fromRGB(83, 226, 242),
}

local function part(parent, name, size, cf, color, material, transparency, collide)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame = name, size, cf
    p.Color = color or C.navy
    p.Material = material or Enum.Material.SmoothPlastic
    p.Transparency = transparency or 0
    p.Anchored = true
    p.CanCollide = collide ~= false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function localPart(parent, plot, name, size, pos, color, material, transparency, collide, rotation)
    return part(parent, name, size, plot.cf * CFrame.new(pos) * (rotation or CFrame.new()), color, material, transparency, collide)
end

local function model(parent, name)
    local m = Instance.new("Model")
    m.Name, m.Parent = name, parent
    return m
end

local function surface(p, title, color, textSize, face)
    local gui = Instance.new("SurfaceGui")
    gui.Name, gui.Face = "Display", face or Enum.NormalId.Front
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 28
    gui.LightInfluence = 0
    gui.Parent = p
    local label = Instance.new("TextLabel")
    label.Name = "Text"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = color or C.white
    label.Font = Enum.Font.GothamBold
    label.TextSize = textSize or 32
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = gui
    local pad = Instance.new("UIPadding")
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0.12, 0), UDim.new(0.12, 0)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0.06, 0), UDim.new(0.06, 0)
    pad.Parent = label
    return label
end

local function floating(p, title, color, distance, offset)
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Size = "Label", UDim2.fromOffset(230, 58)
    gui.StudsOffsetWorldSpace = offset or Vector3.new(0, 3, 0)
    gui.MaxDistance, gui.AlwaysOnTop = distance or 70, false
    gui.Parent = p
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    label.Font, label.TextSize = Enum.Font.GothamBold, 17
    label.TextColor3, label.TextStrokeTransparency = color or C.white, 0.45
    label.Text, label.TextWrapped = title, true
    label.Parent = gui
    return label
end

local function prompt(p, action, object, handler)
    local q = Instance.new("ProximityPrompt")
    q.ActionText, q.ObjectText = action, object
    q.KeyboardKeyCode = Enum.KeyCode.E
    q.GamepadKeyCode = Enum.KeyCode.ButtonX
    q.MaxActivationDistance, q.HoldDuration = 10, 0.2
    q.RequiresLineOfSight = false
    q.Parent = p
    q.Triggered:Connect(handler)
    return q
end

local function light(p, color, brightness, range)
    local l = Instance.new("PointLight")
    l.Color, l.Brightness, l.Range = color, brightness or 0.7, range or 16
    l.Shadows = false
    l.Parent = p
end

local function tree(parent, x, z, height)
    part(parent, "Planter", Vector3.new(7, 1.5, 7), CFrame.new(x, 1, z), C.stone)
    part(parent, "Trunk", Vector3.new(1.1, height * 0.6, 1.1), CFrame.new(x, 2 + height * 0.3, z), Color3.fromRGB(95, 73, 60), Enum.Material.Wood)
    local crown = part(parent, "Crown", Vector3.new(7, height * 0.65, 7), CFrame.new(x, 3 + height * 0.7, z), Color3.fromRGB(39, 107, 87), Enum.Material.Grass)
    crown.Shape = Enum.PartType.Ball
end

local function desk(parent, plot, pos, accent, style, worker)
    local d = model(parent, "BrokerDesk")
    local x, y, z = pos.X, pos.Y, pos.Z
    localPart(d, plot, "DeskTop", Vector3.new(9, 0.5, 4), Vector3.new(x, y + 3.3, z), style == "luxury" and C.gold or C.stone)
    for _, dx in ipairs({-3.6, 3.6}) do
        localPart(d, plot, "Leg", Vector3.new(0.5, 3.1, 3), Vector3.new(x + dx, y + 1.6, z), C.ink)
    end
    local monitors = style == "multi" and {-2.8, 0, 2.8} or {0}
    for _, dx in ipairs(monitors) do
        localPart(d, plot, "MonitorStem", Vector3.new(0.25, 1, 0.3), Vector3.new(x + dx, y + 4, z + 0.8), C.ink)
        localPart(d, plot, "Monitor", Vector3.new(2.65, 1.8, 0.22), Vector3.new(x + dx, y + 4.9, z + 0.8), C.ink)
        local screen = localPart(d, plot, "Screen", Vector3.new(2.3, 1.45, 0.04), Vector3.new(x + dx, y + 4.9, z + 0.66), Color3.fromRGB(12, 45, 50), Enum.Material.Neon, 0, false)
        for n = 1, 5 do
            local h = 0.2 + ((n * 7 + math.floor(x)) % 5) * 0.2
            localPart(d, plot, "ChartBar", Vector3.new(0.25, h, 0.05), Vector3.new(x + dx - 0.8 + n * 0.28, y + 4.3 + h / 2, z + 0.62), accent, Enum.Material.Neon, 0, false)
        end
    end
    localPart(d, plot, "Keyboard", Vector3.new(2.2, 0.1, 0.75), Vector3.new(x, y + 3.62, z - 0.65), C.ink)
    localPart(d, plot, "Phone", Vector3.new(0.7, 0.22, 1.1), Vector3.new(x - 3.2, y + 3.67, z - 0.6), accent)
    localPart(d, plot, "Chair", Vector3.new(2.7, 0.4, 2.7), Vector3.new(x, y + 1.65, z - 3.3), C.ink)
    localPart(d, plot, "ChairBack", Vector3.new(2.7, 2.9, 0.4), Vector3.new(x, y + 3, z - 4.4), C.ink)
    if worker then
        local skin = Color3.fromRGB(196 + (worker % 3) * 15, 150 + (worker % 3) * 12, 119 + (worker % 3) * 9)
        localPart(d, plot, "Suit", Vector3.new(1.8, 2, 1), Vector3.new(x, y + 3.1, z - 3), C.navy)
        localPart(d, plot, "Shirt", Vector3.new(0.5, 1.7, 0.1), Vector3.new(x, y + 3.2, z - 2.45), C.white)
        localPart(d, plot, "Tie", Vector3.new(0.2, 1.2, 0.1), Vector3.new(x, y + 3.1, z - 2.36), accent)
        local head = localPart(d, plot, "Head", Vector3.new(1.35, 1.35, 1.35), Vector3.new(x, y + 4.7, z - 3), skin)
        head.Shape = Enum.PartType.Ball
        localPart(d, plot, "Hair", Vector3.new(1.4, 0.35, 1.4), Vector3.new(x, y + 5.25, z - 3), C.ink)
        for _, dx in ipairs({-1.15, 1.15}) do
            localPart(d, plot, "Sleeve", Vector3.new(0.65, 0.7, 1.8), Vector3.new(x + dx, y + 3.25, z - 2.3), C.navy)
            localPart(d, plot, "Hand", Vector3.new(0.65, 0.45, 0.6), Vector3.new(x + dx, y + 3.3, z - 1.35), skin)
        end
    end
    return d
end

local function coffee(parent, plot, pos)
    localPart(parent, plot, "CoffeeCabinet", Vector3.new(9, 3, 3), pos + Vector3.new(0, 1.5, 0), Color3.fromRGB(98, 69, 51), Enum.Material.Wood)
    localPart(parent, plot, "CoffeeTop", Vector3.new(9.4, 0.35, 3.4), pos + Vector3.new(0, 3.2, 0), C.white)
    localPart(parent, plot, "CoffeeMachine", Vector3.new(2.4, 2.6, 2), pos + Vector3.new(-1.8, 4.6, 0), C.ink, Enum.Material.Metal)
    localPart(parent, plot, "CoffeeLED", Vector3.new(1.6, 0.3, 0.1), pos + Vector3.new(-1.8, 5.3, -1.05), C.green, Enum.Material.Neon)
    for _, x in ipairs({1.5, 2.5, 3.5}) do
        local cup = localPart(parent, plot, "Cup", Vector3.new(0.75, 0.55, 0.55), pos + Vector3.new(x, 3.7, 0), C.white, nil, 0, true, CFrame.Angles(0, 0, math.pi / 2))
        cup.Shape = Enum.PartType.Cylinder
    end
    floating(parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart"), "KAWA = LEPSZE WYNIKI", C.gold, 32)
end

local function racks(parent, plot, pos, accent)
    for _, x in ipairs({-3.5, 0, 3.5}) do
        localPart(parent, plot, "ServerCabinet", Vector3.new(2.7, 7.5, 3.5), pos + Vector3.new(x, 3.75, 0), C.ink, Enum.Material.Metal)
        for row = 1, 8 do
            localPart(parent, plot, "ServerBlade", Vector3.new(2.3, 0.55, 0.14), pos + Vector3.new(x, row * 0.8, -1.82), C.stone, Enum.Material.Metal)
            localPart(parent, plot, "StatusLED", Vector3.new(0.25, 0.2, 0.16), pos + Vector3.new(x - 0.75, row * 0.8, -1.93), accent, Enum.Material.Neon, 0, false)
        end
    end
end

local function conference(parent, plot, pos, accent)
    localPart(parent, plot, "ConferenceTable", Vector3.new(10, 0.6, 6), pos + Vector3.new(0, 2.9, 0), Color3.fromRGB(78, 54, 43), Enum.Material.Wood)
    localPart(parent, plot, "ConferenceBase", Vector3.new(4, 2.7, 3), pos + Vector3.new(0, 1.35, 0), C.ink)
    for _, x in ipairs({-3.5, 0, 3.5}) do
        for _, z in ipairs({-4.1, 4.1}) do
            localPart(parent, plot, "ConferenceChair", Vector3.new(2.2, 2.3, 1.4), pos + Vector3.new(x, 1.3, z), C.navy)
        end
    end
    localPart(parent, plot, "TableCenter", Vector3.new(5, 0.12, 0.18), pos + Vector3.new(0, 3.25, 0), accent, Enum.Material.Neon, 0, false)
end

local function lounge(parent, plot, pos, accent)
    localPart(parent, plot, "SofaBase", Vector3.new(10, 1.1, 3), pos + Vector3.new(0, 1.1, 0), accent, Enum.Material.Fabric)
    localPart(parent, plot, "SofaBack", Vector3.new(10, 2.4, 0.7), pos + Vector3.new(0, 2.4, 1.4), accent, Enum.Material.Fabric)
    for _, x in ipairs({-4.7, 4.7}) do
        localPart(parent, plot, "SofaArm", Vector3.new(0.7, 1.7, 3), pos + Vector3.new(x, 2, 0), accent, Enum.Material.Fabric)
    end
    localPart(parent, plot, "CoffeeTable", Vector3.new(6, 0.35, 3), pos + Vector3.new(0, 1.6, -4.5), C.white)
    localPart(parent, plot, "CoffeeTableBase", Vector3.new(3, 1.5, 1), pos + Vector3.new(0, 0.75, -4.5), C.gold)
end

local function wolf(parent, cf, scale)
    -- A stylized origami wolf, built from solid geometry rather than a mesh asset.
    local gold = C.gold
    local function w(name, size, pos, rot)
        return part(parent, name, size * scale, cf * CFrame.new(pos * scale) * (rot or CFrame.new()), gold, Enum.Material.Metal)
    end
    w("WolfBody", Vector3.new(3.4, 3.4, 6.5), Vector3.new(0, 5.5, 0), CFrame.Angles(math.rad(-12), 0, 0))
    for _, x in ipairs({-1.2, 1.2}) do
        w("WolfFrontLeg", Vector3.new(0.75, 4, 0.9), Vector3.new(x, 2.4, -2.1))
        w("WolfBackLeg", Vector3.new(0.9, 3.4, 1.1), Vector3.new(x, 2.4, 2.1), CFrame.Angles(math.rad(-18), 0, 0))
        w("WolfPaw", Vector3.new(1, 0.6, 1.5), Vector3.new(x, 0.65, -2.4))
    end
    w("WolfNeck", Vector3.new(2.8, 3.8, 2.7), Vector3.new(0, 7.5, -2.2), CFrame.Angles(math.rad(-23), 0, 0))
    w("WolfHead", Vector3.new(2.9, 2.5, 3.2), Vector3.new(0, 9.3, -3.4), CFrame.Angles(math.rad(8), 0, 0))
    w("WolfMuzzle", Vector3.new(1.7, 1.3, 2.8), Vector3.new(0, 9.15, -5.3), CFrame.Angles(math.rad(-8), 0, 0))
    for _, x in ipairs({-0.95, 0.95}) do
        w("WolfEar", Vector3.new(0.8, 2.2, 0.8), Vector3.new(x, 11.25, -2.8), CFrame.Angles(0, math.rad(45), x * -0.25))
        part(parent, "WolfEye", Vector3.new(0.2, 0.25, 0.55) * scale, cf * CFrame.new(Vector3.new(x * 1.55, 9.65, -4.1) * scale), C.ink, Enum.Material.Neon, 0, false)
    end
    w("WolfTail", Vector3.new(1.3, 1.4, 4.2), Vector3.new(0, 4.6, 4.2), CFrame.Angles(math.rad(32), 0, 0))
end

local function floorShell(plot, floor)
    local y, a = (floor - 1) * 16, plot.accent
    local f = model(plot.interior, "Floor" .. floor)
    localPart(f, plot, "FloorSlab", Vector3.new(58, 1, 58), Vector3.new(0, y - 0.5, 0), floor == 3 and Color3.fromRGB(64, 65, 68) or C.navy, Enum.Material.Marble)
    localPart(f, plot, "Carpet", Vector3.new(9, 0.05, 54), Vector3.new(0, y + 0.03, -1), Color3.fromRGB(27, 57, 62), Enum.Material.Fabric, 0, false)
    for _, x in ipairs({-28.5, 28.5}) do
        localPart(f, plot, "GlassWall", Vector3.new(0.35, 12, 57), Vector3.new(x, y + 7, 0), C.glass, Enum.Material.Glass, 0.65)
        for _, z in ipairs({-28.5, 0, 28.5}) do
            localPart(f, plot, "Pillar", Vector3.new(1, 15.5, 1), Vector3.new(x, y + 7.5, z), C.stone, Enum.Material.Metal)
        end
        localPart(f, plot, "LightRail", Vector3.new(0.5, 0.25, 58), Vector3.new(x, y + 14.6, 0), a, Enum.Material.Neon, 0, false)
    end
    localPart(f, plot, "BackWall", Vector3.new(58, 14.5, 0.5), Vector3.new(0, y + 7, 28.6), C.ink)
    localPart(f, plot, "FrontBeam", Vector3.new(58, 0.8, 0.8), Vector3.new(0, y + 14.5, -28.5), C.stone, Enum.Material.Metal)
    localPart(f, plot, "FrontLight", Vector3.new(58, 0.15, 0.15), Vector3.new(0, y + 14, -29), a, Enum.Material.Neon, 0, false)
    local board = localPart(f, plot, "FloorSign", Vector3.new(27, 4.2, 0.3), Vector3.new(0, y + 9, 28.1), C.ink, nil, 0, false)
    surface(board, ({"01  //  STARTUP", "02  //  TRADING FLOOR", "03  //  THE WOLF CLUB"})[floor], a)
    -- A framed elevator pad, accessible on every unlocked floor.
    localPart(f, plot, "LiftBase", Vector3.new(6, 0.2, 6), Vector3.new(23.5, y + 0.15, -23.5), a, Enum.Material.Neon)
    localPart(f, plot, "LiftBack", Vector3.new(6, 10, 0.5), Vector3.new(23.5, y + 5, -20.3), C.ink)
    local liftTitle = localPart(f, plot, "LiftTitle", Vector3.new(5.5, 1.4, 0.2), Vector3.new(23.5, y + 8, -20.65), C.ink, nil, 0, false)
    surface(liftTitle, "WINDA", a)
    for target = 1, 3 do
        local button = localPart(f, plot, "LiftButton" .. target, Vector3.new(1.3, 1.3, 0.3), Vector3.new(21.7 + (target - 1) * 1.8, y + 5.8, -20.7), a, Enum.Material.Neon, 0, false)
        surface(button, tostring(target), C.ink)
        local liftPrompt = prompt(button, "Jedź na piętro " .. target, "Winda • Twoje biuro", function(player)
            if plot.player == player then World.Home(player, target) end
        end)
        liftPrompt.KeyboardKeyCode = ({Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three})[target]
        liftPrompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
    end
    return f
end

local function furniture(plot, index)
    local entry = config.Upgrades[index]
    if not entry then return end
    local floor = entry.floor or (math.floor((index - 1) / 6) + 1)
    local slot = (index - 1) % 6
    local x, z = slot % 2 == 0 and -16 or 16, -13 + math.floor(slot / 2) * 15
    local pos = Vector3.new(x, (floor - 1) * 16, z)
    local item = model(plot.interior, "Upgrade" .. index)
    if index == 4 then
        coffee(item, plot, pos)
    elseif index == 9 then
        racks(item, plot, pos, plot.accent)
    elseif index == 11 or index == 16 then
        conference(item, plot, pos, plot.accent)
    elseif index == 17 then
        lounge(item, plot, pos, plot.accent)
    elseif index == 18 then
        localPart(item, plot, "TrophyPedestal", Vector3.new(7, 1, 7), pos + Vector3.new(0, 0.5, 0), C.ink, Enum.Material.Marble)
        wolf(item, plot.cf * CFrame.new(pos + Vector3.new(0, 1, 0)), 0.6)
    else
        local multi = index == 3 or index == 8 or index == 10 or index == 14 or index == 15
        desk(item, plot, pos, plot.accent, index &gt;= 12 and "luxury" or (multi and "multi" or "single"), index &gt; 1 and index or nil)
    end
    local plate = localPart(item, plot, "UpgradePlaque", Vector3.new(11, 0.1, 1.8), pos + Vector3.new(0, 0.1, -5.8), C.ink, nil, 0, false)
    surface(plate, entry.name, plot.accent, 20, Enum.NormalId.Top)
end

local function nextPad(plot)
    local old = plot.model:FindFirstChild("NextPurchase")
    if old then old:Destroy() end
    local index = plot.level + 1
    local entry = config.Upgrades[index]
    if not entry then return end
    -- Floor unlocks are purchased from the highest floor already accessible.
    local floor = math.min(entry.floor or math.ceil(index / 6), plot.level &gt;= 13 and 3 or (plot.level &gt;= 7 and 2 or 1))
    local y = (floor - 1) * 16
    local group = model(plot.model, "NextPurchase")
    localPart(group, plot, "PurchaseBorder", Vector3.new(8, 0.25, 7), Vector3.new(0, y + 0.2, -18), plot.accent, Enum.Material.Neon)
    local pad = localPart(group, plot, "PurchasePad", Vector3.new(7.3, 0.3, 6.3), Vector3.new(0, y + 0.4, -18), C.ink)
    local text = string.format("%s\n$%s", entry.name, config.Format and config.Format(entry.price) or tostring(entry.price))
    surface(pad, text, plot.accent, 20, Enum.NormalId.Top)
    floating(pad, text, plot.accent, 55, Vector3.new(0, 3.3, 0))
    prompt(pad, "Kup ulepszenie", entry.name .. " • $" .. (config.Format and config.Format(entry.price) or entry.price), function(player)
        if plot.player == player and onAction then onAction(player, "Buy") end
    end)
    light(pad, plot.accent, 0.8, 14)
end

local function skyline()
    local m = model(root, "CitySkyline")
    for i = 1, 24 do
        local side = i &lt;= 12 and -1 or 1
        local n = (i - 1) % 12
        local x = side * (133 + (n % 3) * 33)
        local z = -240 + math.floor(n / 3) * 152
        local h = 38 + ((i * 37) % 87)
        local w, d = 23 + (i % 3) * 5, 32 + (i % 4) * 5
        part(m, "Tower", Vector3.new(w, h, d), CFrame.new(x, h / 2, z), i % 2 == 0 and C.navy or C.ink)
        part(m, "TowerCrown", Vector3.new(w + 1, 0.4, d + 1), CFrame.new(x, h, z), accents[(i - 1) % 6 + 1], Enum.Material.Neon, 0, false)
        for floor = 1, math.floor(h / 8) do
            part(m, "WindowStrip", Vector3.new(w + 0.1, 2.5, d + 0.1), CFrame.new(x, floor * 8 - 2, z), Color3.fromRGB(88, 125, 148), Enum.Material.Glass, 0.3, false)
        end
    end
    for i = 1, 8 do
        local x = -112 + (i - 1) * 32
        local h = 46 + (i * 19) % 75
        for _, z in ipairs({-275, 275}) do
            part(m, "HorizonTower", Vector3.new(26, h, 35), CFrame.new(x, h / 2, z), C.ink)
            part(m, "HorizonCrown", Vector3.new(26, 0.5, 35), CFrame.new(x, h, z), Color3.fromRGB(77, 122, 151), Enum.Material.Neon, 0, false)
        end
    end
end

function World.Init(settings, callback)
    config, onAction = settings, callback
    local previous = Workspace:FindFirstChild("WolfStreet")
    if previous then previous:Destroy() end
    plots, owners = {}, {}
    root = model(Workspace, "WolfStreet")
    Workspace.FallenPartsDestroyHeight = -80
    Lighting.ClockTime, Lighting.Brightness = 18.4, 2.4
    Lighting.Ambient = Color3.fromRGB(90, 105, 137)
    Lighting.OutdoorAmbient = Color3.fromRGB(113, 126, 155)
    Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(57, 79, 110), 250, 1100
    Lighting.GlobalShadows = true
    local atmosphere = Lighting:FindFirstChild("WolfAtmosphere") or Instance.new("Atmosphere")
    atmosphere.Name, atmosphere.Density, atmosphere.Offset = "WolfAtmosphere", 0.23, 0.25
    atmosphere.Color, atmosphere.Decay = Color3.fromRGB(172, 189, 212), Color3.fromRGB(75, 100, 135)
    atmosphere.Parent = Lighting
    local bloom = Lighting:FindFirstChild("WolfBloom") or Instance.new("BloomEffect")
    bloom.Name, bloom.Intensity, bloom.Size, bloom.Threshold = "WolfBloom", 0.28, 28, 1.3
    bloom.Parent = Lighting
    local grade = Lighting:FindFirstChild("WolfGrade") or Instance.new("ColorCorrectionEffect")
    grade.Name, grade.Contrast, grade.Saturation = "WolfGrade", 0.12, 0.07
    grade.Parent = Lighting

    part(root, "CityGround", Vector3.new(620, 2, 660), CFrame.new(0, -1.1, 0), Color3.fromRGB(39, 49, 61), Enum.Material.Concrete)
    part(root, "Avenue", Vector3.new(27, 0.3, 420), CFrame.new(0, 0.08, 0), C.road, Enum.Material.Asphalt)
    for _, x in ipairs({-18, 18}) do
        part(root, "Sidewalk", Vector3.new(8, 0.7, 410), CFrame.new(x, 0.28, 0), Color3.fromRGB(96, 108, 120), Enum.Material.Concrete)
        part(root, "SidewalkNeon", Vector3.new(0.2, 0.2, 410), CFrame.new(x + (x &lt; 0 and -3.8 or 3.8), 0.72, 0), C.green, Enum.Material.Neon, 0, false)
    end
    for z = -200, 200, 18 do
        part(root, "RoadMarking", Vector3.new(0.4, 0.05, 7), CFrame.new(0, 0.26, z), C.gold, Enum.Material.Neon, 0, false)
    end
    for _, z in ipairs({-127, -42, 42, 127}) do
        for x = -10, 10, 4 do
            part(root, "Crosswalk", Vector3.new(2, 0.06, 6), CFrame.new(x, 0.3, z), C.white, nil, 0, false)
        end
        for _, x in ipairs({-19, 19}) do
            local pole = part(root, "StreetLamp", Vector3.new(0.5, 17, 0.5), CFrame.new(x, 8.5, z + 5), C.ink, Enum.Material.Metal)
            local lamp = part(root, "Lamp", Vector3.new(3, 0.4, 2), CFrame.new(x, 17, z + 5), C.white, Enum.Material.Neon)
            light(lamp, Color3.fromRGB(215, 232, 255), 1.6, 30)
        end
    end

    local plaza = model(root, "WolfPlaza")
    part(plaza, "Plaza", Vector3.new(82, 0.8, 52), CFrame.new(0, 0.45, -179), C.navy, Enum.Material.Marble)
    local pedestal = part(plaza, "GoldenWolfPedestal", Vector3.new(14, 3, 19), CFrame.new(0, 2.3, -180), C.ink, Enum.Material.Marble)
    wolf(plaza, CFrame.new(0, 3.8, -180) * CFrame.Angles(0, math.rad(180), 0), 1.2)
    local plaque = part(plaza, "Plaque", Vector3.new(12, 1.6, 0.15), CFrame.new(0, 2.6, -170.4) * CFrame.Angles(0, math.pi, 0), C.ink, nil, 0, false)
    surface(plaque, "THE WOLF OF WALL STREET", C.gold)
    local header = part(plaza, "WelcomeSign", Vector3.new(60, 7, 1), CFrame.new(0, 25, -197) * CFrame.Angles(0, math.pi, 0), C.ink)
    surface(header, "WOLF STREET", C.gold)
    local reverse = surface(header, "WOLF STREET", C.gold, 32, Enum.NormalId.Back)
    for _, x in ipairs({-29, 29}) do
        part(plaza, "WelcomePillar", Vector3.new(1.4, 25, 1.4), CFrame.new(x, 12.5, -197), C.stone)
        tree(plaza, x, -166, 11)
    end
    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Size, spawn.CFrame = "CityArrival", Vector3.new(10, 0.4, 8), CFrame.new(0, 1.15, -150)
    spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
    spawn.Color, spawn.Material = C.gold, Enum.Material.Neon
    spawn.Parent = root
    local guide = part(root, "WelcomeGuide", Vector3.new(24, 9, 0.5), CFrame.new(-34, 7, -145) * CFrame.Angles(0, math.rad(-25), 0), C.ink)
    surface(guide, "TWÓJ PIERWSZY MILION\n1. Wróć do swojego biura\n2. Domykaj kontrakty\n3. Rozbuduj imperium", C.white)
    for _, z in ipairs({-150, 150}) do
        for _, x in ipairs({-105, 105}) do tree(root, x, z, 14) end
    end

    local market = model(root, "MarketBoard")
    local board = part(market, "MarketNews", Vector3.new(29, 11, 1), CFrame.new(0, 20, 167), C.ink)
    marketLabel = surface(board, "WOLF EXCHANGE\nRynek czeka na otwarcie", C.green)
    surface(board, "WOLF EXCHANGE\nZbuduj własne imperium", C.green, 32, Enum.NormalId.Back)
    for _, x in ipairs({-13, 13}) do
        part(market, "MarketSupport", Vector3.new(1.2, 20, 1.2), CFrame.new(x, 10, 167), C.stone)
    end

    for i = 1, 6 do
        local left = i &lt;= 3
        local z = ((i - 1) % 3 - 1) * 84
        local cf = CFrame.new(left and -55 or 55, 2, z) * CFrame.Angles(0, left and -math.pi / 2 or math.pi / 2, 0)
        local m = model(root, "Tycoon" .. i)
        local plot = {id = i, model = m, cf = cf, origin = cf.Position, accent = accents[i], level = 0, prestige = 0}
        plots[i] = plot
        localPart(m, plot, "Foundation", Vector3.new(64, 2, 64), Vector3.new(0, -1, 0), C.stone, Enum.Material.Concrete)
        localPart(m, plot, "EntrySteps", Vector3.new(14, 1, 4), Vector3.new(0, -1.5, -34), C.navy)
        localPart(m, plot, "EntryNeon", Vector3.new(14, 0.12, 0.18), Vector3.new(0, -0.95, -35.9), plot.accent, Enum.Material.Neon, 0, false)
        local ownerBoard = localPart(m, plot, "OwnerSign", Vector3.new(44, 4.5, 0.8), Vector3.new(0, 13, -29.5), C.ink)
        plot.ownerLabel = surface(ownerBoard, "BIURO " .. i .. "  //  WOLNE", plot.accent)
        localPart(m, plot, "OwnerSignTrim", Vector3.new(44, 0.16, 1), Vector3.new(0, 15.4, -29.5), plot.accent, Enum.Material.Neon, 0, false)
        local preview = model(m, "Vacant")
        localPart(preview, plot, "VacantOutline", Vector3.new(58, 0.15, 58), Vector3.new(0, 0.05, 0), C.ink)
        local pin = localPart(preview, plot, "VacantMarker", Vector3.new(4, 5, 4), Vector3.new(0, 2.5, 0), C.navy)
        floating(pin, "TWOJE PRZYSZŁE IMPERIUM", plot.accent, 65)
    end
    skyline()
    return World
end

function World.Assign(player)
    if owners[player] then return owners[player] end
    for _, plot in ipairs(plots) do
        if not plot.player then
            plot.player = player
            owners[player] = plot
            plot.ownerLabel.Text = string.upper(player.DisplayName) .. "  //  WOLF CAPITAL"
            local vacant = plot.model:FindFirstChild("Vacant")
            if vacant then vacant:Destroy() end
            plot.interior = model(plot.model, "Interior")
            plot.level, plot.prestige = -1, -1
            World.Update(player, 0, 0)
            return plot
        end
    end
    return nil
end

function World.Update(player, level, prestige)
    local plot = owners[player]
    if not plot then return end
    level = math.clamp(math.floor(tonumber(level) or 0), 0, #config.Upgrades)
    prestige = math.max(0, math.floor(tonumber(prestige) or 0))
    if plot.level == level and plot.prestige == prestige then return end
    local reset = level &lt; plot.level or plot.level &lt; 0
    if reset then
        plot.interior:ClearAllChildren()
        floorShell(plot, 1)
        local booth = model(plot.interior, "YourTradingDesk")
        desk(booth, plot, Vector3.new(0, 0, 7), plot.accent, "single")
        local phone = localPart(booth, plot, "PitchPhone", Vector3.new(1, 0.3, 1.4), Vector3.new(3, 3.8, 6.2), C.gold, Enum.Material.Neon)
        floating(phone, "TWÓJ TERMINAL\nDomykaj kontrakty", C.gold, 45, Vector3.new(0, 3, 0))
        prompt(phone, "Domknij kontrakt", "Terminal maklera", function(who)
            if who == plot.player and onAction then onAction(who, "Pitch") end
        end)
        plot.level = 0
    end
    for index = plot.level + 1, level do
        if index == 7 then floorShell(plot, 2) end
        if index == 13 then floorShell(plot, 3) end
        furniture(plot, index)
    end
    plot.level, plot.prestige = level, prestige
    plot.ownerLabel.Text = string.upper(player.DisplayName) .. "  //  " .. (prestige &gt; 0 and ("WILK " .. prestige .. "  ★") or "WOLF CAPITAL")
    nextPad(plot)
end

function World.Home(player, targetFloor)
    local plot = owners[player]
    if not plot then return false end
    local maxFloor = plot.level &gt;= 13 and 3 or (plot.level &gt;= 7 and 2 or 1)
    local requested = tonumber(targetFloor) or 1
    if requested ~= requested or requested == math.huge or requested == -math.huge then return false end
    local floor = math.floor(requested)
    if floor &lt; 1 or floor &gt; maxFloor then return false end
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local target = plot.cf * CFrame.new(0, 4 + (floor - 1) * 16, -24)
    character:PivotTo(target * CFrame.Angles(0, math.pi, 0))
    hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    return true
end

function World.Near(player)
    local plot = owners[player]
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    return plot ~= nil and hrp ~= nil and (hrp.Position - plot.origin).Magnitude &lt;= 85
end

function World.Release(player)
    local plot = owners[player]
    if not plot then return end
    owners[player] = nil
    plot.player, plot.level, plot.prestige = nil, 0, 0
    if plot.interior then plot.interior:Destroy() end
    plot.interior = nil
    local nextPurchase = plot.model:FindFirstChild("NextPurchase")
    if nextPurchase then nextPurchase:Destroy() end
    plot.ownerLabel.Text = "BIURO " .. plot.id .. "  //  WOLNE"
    local vacant = model(plot.model, "Vacant")
    localPart(vacant, plot, "VacantOutline", Vector3.new(58, 0.15, 58), Vector3.new(0, 0.05, 0), C.ink)
    local pin = localPart(vacant, plot, "VacantMarker", Vector3.new(4, 5, 4), Vector3.new(0, 2.5, 0), C.navy)
    floating(pin, "TWOJE PRZYSZŁE IMPERIUM", plot.accent, 65)
end

function World.SetMarket(event)
    if not marketLabel or not event then return end
    marketLabel.Text = "WOLF EXCHANGE\n" .. string.upper(event.title or "SESJA OTWARTA") .. "\n" .. (event.description or "Wybierz strategię w panelu rynku")
end

return World
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000004CF">
      <Properties>
        <string name="Name">Persistence</string>
        <ProtectedString name="Source">-- Session-locked DataStore. Failed loads never become writable fresh profiles.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Persistence = {}
local store
local Config
local records = {}
local function copy(data)
    local result = {}
    for key,value in pairs(data) do result[key] = value end
    return result
end
function Persistence.Init(config)
    Config = config
    -- GetDataStore itself can fail in an unpublished Studio place.
    local ok, result = pcall(function()
        return DataStoreService:GetDataStore("WolfStreetTycoon_v1")
    end)
    store = ok and result or nil
end
function Persistence.Load(player)
    local token = game.JobId .. ":" .. HttpService:GenerateGUID(false)
    local key = "p_" .. player.UserId
    local locked = false
    local ok, result = pcall(function()
        if not store then error("DataStore unavailable in this place") end
        return store:UpdateAsync(key,function(old)
            if type(old) == "table" and type(old.session) == "table"
                and old.session.id ~= token and type(old.session.expiresAt) == "number"
                and old.session.expiresAt &gt; os.time() then
                locked = true
                return nil
            end
            local data = type(old) == "table" and old.data or nil
            return {version=Config.Version, data=data or {}, session={id=token, expiresAt=os.time()+Config.SessionLease}}
        end)
    end)
    if ok and type(result) == "table" and result.session and result.session.id == token then
        records[player] = {key=key, token=token, writable=true, saving=false}
        return result.data, "Zapis aktywny"
    end
    if locked then return nil, "Twój profil jest otwarty na innym serwerze. Spróbuj ponownie za chwilę." end
    if RunService:IsStudio() or game.GameId == 0 then
        records[player] = {writable=false, saving=false}
        warn("Wolf Street: DataStore niedostępny; lokalny test bez zapisu. " .. tostring(result))
        return {}, "Tryb testowy · bez zapisu"
    end
    warn("Wolf Street profile load failed for " .. player.UserId .. ": " .. tostring(result))
    return nil, "Nie udało się bezpiecznie odczytać zapisu. Spróbuj ponownie za chwilę."
end
function Persistence.CanSave(player)
    return records[player] and records[player].writable or false
end
function Persistence.Save(player,data,release)
    local record = records[player]
    if not record or not record.writable then
        if release then records[player] = nil end
        return false, "Tryb testowy · bez zapisu"
    end
    if record.saving then
        if not release then return false, "Zapis w toku" end
        local deadline = os.clock()+12
        while record.saving and os.clock()&lt;deadline do task.wait(0.1) end
        if record.saving then return false, "Zapis nie został zakończony" end
    end
    record.saving = true
    local snapshot = copy(data)
    local success = false
    local lost = false
    for attempt=1,3 do
        local ok, result = pcall(function()
            return store:UpdateAsync(record.key,function(old)
                if type(old) ~= "table" or type(old.session) ~= "table" or old.session.id ~= record.token then
                    return nil
                end
                return {
                    version=Config.Version, data=snapshot,
                    session=release and {id=record.token, expiresAt=0} or {id=record.token, expiresAt=os.time()+Config.SessionLease},
                }
            end)
        end)
        if ok and type(result) == "table" and result.session and result.session.id == record.token then
            success = true
            break
        end
        if ok then lost = true; break end
        if attempt &lt; 3 then task.wait(attempt) end
    end
    record.saving = false
    if lost then record.writable = false end
    if release then records[player] = nil end
    if success then return true, "Zapisano postęp" end
    return false, lost and "Sesja zapisu wygasła" or "Problem z zapisem · ponawiam"
end
return Persistence
</ProtectedString>
      </Properties>
