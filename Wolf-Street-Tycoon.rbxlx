    <Item class="Script" referent="RBX000004D0">
      <Properties>
        <string name="Name">WolfServer</string>
        <ProtectedString name="Source">-- All gameplay decisions, rewards and cooldowns run on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("WolfConfig"))
local Economy = require(script.Parent:WaitForChild("Economy"))
local Persistence = require(script.Parent:WaitForChild("Persistence"))
local World = require(script.Parent:WaitForChild("World"))
Economy.Init(Config)
Persistence.Init(Config)
local net = Instance.new("Folder")
net.Name = "WolfNet"
local action = Instance.new("RemoteEvent"); action.Name="Action"; action.Parent=net
local state = Instance.new("RemoteEvent"); state.Name="State"; state.Parent=net
local notice = Instance.new("RemoteEvent"); notice.Name="Notice"; notice.Parent=net
net.Parent=ReplicatedStorage
local sessions = {}
local joining = {}
local shuttingDown = false
local eventIndex = 0
local currentEvent
local market = {
    {ticker="BYTE",value=124.8,delta=1.8}, {ticker="NOVA",value=78.4,delta=2.1}, {ticker="LINK",value=216.2,delta=-0.6},
}
local function now() return workspace:GetServerTimeNow() end
local function tell(player,message,kind)
    if player.Parent then notice:FireClient(player,message,kind or "info") end
end
local function beginEvent()
    eventIndex = eventIndex + 1
    local config = Config.Events[((eventIndex-1) % #Config.Events)+1]
    currentEvent = {id=eventIndex,title=config.title,description=config.description,best=config.best,endsAt=now()+Config.EventDuration}
    for _, item in ipairs(market) do
        item.delta = item.ticker == config.ticker and 3.6 or (eventIndex%2==0 and 0.8 or -0.4)
        item.value = math.floor(item.value*(1+item.delta/100)*100)/100
        if item.value &gt; 9999 then item.value = item.value / 10 end
    end
    for _, s in pairs(sessions) do s.choice=nil; s.creditedStrategy=false end
    if World.SetMarket then World.SetMarket(currentEvent) end
end
local function choiceFor(s)
    if now() &gt;= currentEvent.endsAt then return nil end
    return s.choice
end
local function snapshot(player)
    local s = sessions[player]
    if not s then return end
    local d = s.data
    if now() &gt; s.comboExpires then s.combo=0 end
    local choice = choiceFor(s)
    local income = Economy.Income(d,choice,currentEvent.best)
    local nextUpgrade = Config.Upgrades[d.level+1]
    state:FireClient(player,{
        cash=math.floor(d.cash),income=income,prestige=d.prestige,multiplier=Economy.Multiplier(d),level=d.level,maxLevel=#Config.Upgrades,
        nextUpgrade=nextUpgrade,pitchReward=Economy.PitchReward(d,math.min(Config.MaxCombo,s.combo+1),choice,currentEvent.best),
        combo=s.combo,comboExpires=s.comboExpires,pitchReadyAt=s.pitchReadyAt,title=Economy.Title(d),quest=Economy.Quest(d),
        event={id=currentEvent.id,title=currentEvent.title,description=currentEvent.description,endsAt=currentEvent.endsAt,
            choice=choice,options=Config.Strategies},
        market=market,saveStatus=s.saveStatus,dailyReady=os.time()-d.lastDaily&gt;=Config.DailyCooldown,dailyReward=Economy.DailyReward(d),
        prestigeReady=d.level==#Config.Upgrades and d.prestige&lt;Config.MaxPrestige,
    })
    local leader = player:FindFirstChild("leaderstats")
    if leader then
        leader.Gotowka.Value=math.floor(d.cash)
        leader.Prestiz.Value=d.prestige
        leader.Firma.Value=d.level
    end
end
local function perform(player,kind,arg)
    if shuttingDown or type(kind) ~= "string" then return end
    local s = sessions[player]
    if not s or s.leaving then return end
    -- Every request, including Sync and world prompts, shares a rate limiter.
    local timestamp=now()
    s.tokens=math.min(8,s.tokens+(timestamp-s.tokenTime)*4)
    s.tokenTime=timestamp
    if s.tokens&lt;1 then return end
    s.tokens=s.tokens-1
    local d = s.data
    if kind == "Sync" then snapshot(player); return end
    if kind == "Home" then
        if timestamp-s.lastHome&lt;2 then return end
        s.lastHome=timestamp
        World.Home(player,type(arg)=="number" and arg or 1)
        return
    end
    if kind == "Buy" or kind == "Pitch" then
        if not World.Near(player) then tell(player,"Wróć do swojego biura przyciskiem DOM."); return end
    end
    if kind == "Buy" then
        local ok,message = Economy.Buy(d)
        if ok then
            World.Update(player,d.level,d.prestige)
            tell(player,"ODBLOCKOWANO: "..message,"success")
            if d.level==7 or d.level==13 then World.Home(player,Config.Upgrades[d.level].floor) end
        else tell(player,message,"info") end
    elseif kind == "Pitch" then
        if timestamp&lt;s.pitchReadyAt then return end
        if timestamp&gt;s.comboExpires then s.combo=0 end
        s.combo=math.min(Config.MaxCombo,s.combo+1)
        s.comboExpires=timestamp+Config.ComboWindow
        s.pitchReadyAt=timestamp+Config.PitchCooldown
        local reward=Economy.PitchReward(d,s.combo,choiceFor(s),currentEvent.best)
        Economy.Earn(d,reward)
        d.contracts=d.contracts+1
        tell(player,"Kontrakt +$"..Config.Format(reward).." · seria "..s.combo.."/5","cash")
    elseif kind == "Quest" then
        local ok,reward=Economy.ClaimQuest(d)
        if ok then tell(player,"CEL ZREALIZOWANY! +$"..Config.Format(reward),"success") end
    elseif kind == "Strategy" then
        if type(arg)~="string" then return end
        local valid=false
        for _, strategy in ipairs(Config.Strategies) do if strategy.id==arg then valid=true end end
        if not valid or timestamp&gt;=currentEvent.endsAt then return end
        if s.choice==arg then return end
        s.choice=arg
        if arg==currentEvent.best then
            if not s.creditedStrategy then
                d.strategies=d.strategies+1
                s.creditedStrategy=true
            end
            tell(player,"Trafna strategia! Dochód i kontrakty +35% do końca wydarzenia.","success")
        else tell(player,"Strategia aktywna: +10%. Wskazówkę znajdziesz w opisie wydarzenia.") end
    elseif kind == "Daily" then
        local ok,reward=Economy.ClaimDaily(d,os.time())
        if ok then tell(player,"PREMIA ZA POWRÓT +$"..Config.Format(reward),"success")
        else tell(player,"Kolejna premia będzie dostępna 20 godzin po odbiorze.") end
    elseif kind == "Prestige" then
        local ok,message=Economy.Prestige(d)
        if ok then
            s.combo=0; s.comboExpires=0; s.pitchReadyAt=0
            World.Update(player,0,d.prestige); World.Home(player,1)
            tell(player,"NOWE IMPERIUM! Stały mnożnik ×"..string.format("%.2f",Economy.Multiplier(d)),"success")
        else tell(player,message) end
    end
    snapshot(player)
end
World.Init(Config,perform)
beginEvent()
local function join(player)
    if joining[player] or sessions[player] then return end
    joining[player]=true
    local raw,status=Persistence.Load(player)
    if not raw then
        joining[player]=nil
        if player.Parent then player:Kick(status) end
        return
    end
    local data=Economy.Sanitize(raw)
    if not player.Parent or shuttingDown then
        Persistence.Save(player,data,true); joining[player]=nil; return
    end
    local plot=World.Assign(player)
    if not plot then
        Persistence.Save(player,data,true); joining[player]=nil
        player:Kick("Wszystkie 6 biur jest zajętych. Dołącz do innego serwera."); return
    end
    local t=now()
    sessions[player]={data=data,combo=0,comboExpires=0,pitchReadyAt=0,choice=nil,creditedStrategy=false,saveStatus=status,
        tokens=8,tokenTime=t,lastHome=0,lastSave=t,lastAccrual=t,leaving=false}
    joining[player]=nil
    local leader=Instance.new("Folder"); leader.Name="leaderstats"; leader.Parent=player
    for _,name in ipairs({"Gotowka","Prestiz","Firma"}) do
        local value=Instance.new("IntValue"); value.Name=name; value.Parent=leader
    end
    World.Update(player,data.level,data.prestige)
    local function onCharacter(character)
        task.spawn(function()
            local root=character:WaitForChild("HumanoidRootPart",10)
            if root and sessions[player] and player.Character==character then World.Home(player,1) end
        end)
    end
    player.CharacterAdded:Connect(onCharacter)
    if player.Character then onCharacter(player.Character) end
    snapshot(player)
    task.delay(3,function()
        if sessions[player] and player.Parent then tell(player,"Witaj na Wolf Street! Domknij kontrakt, kup telefon i rozkręć firmę.") end
    end)
end
local function leave(player)
    local s=sessions[player]
    if not s or s.leaving then return end
    s.leaving=true
    -- Capture the latest primitive values; autosaves cannot overwrite this final save.
    Persistence.Save(player,s.data,true)
    World.Release(player)
    sessions[player]=nil
end
Players.PlayerAdded:Connect(function(player) task.spawn(join,player) end)
Players.PlayerRemoving:Connect(function(player) task.spawn(leave,player) end)
action.OnServerEvent:Connect(perform)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(join,player) end
task.spawn(function()
    while not shuttingDown do
        task.wait(1)
        local timestamp=now()
        -- Accrue the elapsed segment under its original event before rolling over.
        for _, s in pairs(sessions) do
            if not s.leaving then
                local elapsed=math.max(0,math.min(5,timestamp-s.lastAccrual))
                Economy.Earn(s.data,Economy.Income(s.data,s.choice,currentEvent.best)*elapsed)
                s.lastAccrual=timestamp
            end
        end
        if timestamp&gt;=currentEvent.endsAt then beginEvent() end
        for player,s in pairs(sessions) do
            if player.Parent and not s.leaving then
                snapshot(player)
                if timestamp-s.lastSave&gt;=Config.SaveInterval and not s.saving then
                    s.lastSave=timestamp; s.saving=true
                    task.spawn(function()
                        local ok,message=Persistence.Save(player,s.data,false)
                        s.saveStatus=message; s.saving=false
                        if not ok and message=="Sesja zapisu wygasła" and player.Parent then
                            player:Kick("Twój zapis został otwarty w innej sesji. Dołącz ponownie, aby bezpiecznie kontynuować.")
                        end
                    end)
                end
            end
        end
    end
end)
game:BindToClose(function()
    shuttingDown=true
    for player in pairs(sessions) do task.spawn(leave,player) end
    local deadline=os.clock()+25
    while (next(sessions) or next(joining)) and os.clock()&lt;deadline do task.wait(0.1) end
end)
