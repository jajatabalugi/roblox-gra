          <string name="Name">WolfClient</string>
          <ProtectedString name="Source">-- WOLF STREET TYCOON | Polish HUD. No client-side currency decisions.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local net = ReplicatedStorage:WaitForChild("WolfNet")
local action = net:WaitForChild("Action")
local stateEvent = net:WaitForChild("State")
local noticeEvent = net:WaitForChild("Notice")

local C = {
    bg = Color3.fromRGB(13, 20, 32), panel = Color3.fromRGB(20, 31, 47),
    raised = Color3.fromRGB(30, 44, 62), line = Color3.fromRGB(63, 77, 91),
    white = Color3.fromRGB(248, 245, 232), muted = Color3.fromRGB(165, 184, 196),
    gold = Color3.fromRGB(240, 195, 99), lime = Color3.fromRGB(182, 242, 116),
    red = Color3.fromRGB(255, 133, 137), dark = Color3.fromRGB(21, 35, 27),
}

local function make(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props) do object[key] = value end
    object.Parent = parent
    return object
end
local function corner(object, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 12)}, object)
end
local function stroke(object, color)
    make("UIStroke", {Color = color or C.line, Thickness = 1, Transparency = 0.2}, object)
end
local function text(parent, name, value, size, color, position, dimensions)
    return make("TextLabel", {
        Name = name, BackgroundTransparency = 1, Text = value,
        Font = Enum.Font.Gotham, TextSize = size, TextColor3 = color or C.white,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        Position = position or UDim2.new(), Size = dimensions or UDim2.fromScale(1, 1),
    }, parent)
end
local function button(parent, label, color, position, dimensions, callback)
    local result = make("TextButton", {
        BackgroundColor3 = color or C.raised, BorderSizePixel = 0, Text = label,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = (color == C.lime or color == C.gold) and C.bg or C.white,
        Position = position or UDim2.new(), Size = dimensions or UDim2.fromOffset(120, 36),
        AutoButtonColor = true,
    }, parent)
    corner(result, 9)
    if callback then result.Activated:Connect(callback) end
    return result
end
local function format(value)
    value = tonumber(value) or 0
    if value &gt;= 1000000000 then return string.format("%.2f mld", value / 1000000000) end
    if value &gt;= 1000000 then return string.format("%.2f mln", value / 1000000) end
    if value &gt;= 10000 then return string.format("%.1f tys.", value / 1000) end
    local result = tostring(math.floor(value))
    local formatted = result:reverse():gsub("(%d%d%d)", "%1 "):reverse()
    return formatted:gsub("^%s+", "")
end
local function cash(value) return "$" .. format(value) end
local function serverNow() return workspace:GetServerTimeNow() end

local oldGui = player:WaitForChild("PlayerGui"):FindFirstChild("WolfStreetHUD")
if oldGui then oldGui:Destroy() end
local gui = make("ScreenGui", {
    Name = "WolfStreetHUD", ResetOnSpawn = false, IgnoreGuiInset = false,
    DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player.PlayerGui)
local root = make("Frame", {Name = "Canvas", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1)}, gui)
local snapshot, activePanel = nil, nil
local openPanel
local compact, viewWidth, viewHeight = false, 1200, 720
local displayedCash = 0
local toastNumber = 0

local function send(kind, argument)
    if kind ~= "Sync" and not snapshot then return end
    action:FireServer(kind, argument)
end

local top = make("Frame", {
    Name = "Header", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10),
    Size = UDim2.new(1, -32, 0, 66), BackgroundColor3 = C.bg, BackgroundTransparency = 0.05, BorderSizePixel = 0,
}, root)
corner(top, 13); stroke(top)
local brand = text(top, "Brand", "WOLF STREET", 19, C.gold, UDim2.fromOffset(16, 10), UDim2.fromOffset(210, 24))
brand.Font = Enum.Font.GothamBold
local rank = text(top, "Rank", "TYCOON / PRZYGOTOWYWANIE BIURA", 10, C.muted, UDim2.fromOffset(17, 37), UDim2.fromOffset(320, 17))
local money = text(top, "Cash", "$0", 25, C.white, UDim2.new(1, -265, 0, 8), UDim2.fromOffset(245, 29))
money.Font = Enum.Font.GothamBold; money.TextXAlignment = Enum.TextXAlignment.Right
local income = text(top, "Income", "Ładowanie imperium…", 12, C.lime, UDim2.new(1, -265, 0, 38), UDim2.fromOffset(245, 19))
income.TextXAlignment = Enum.TextXAlignment.Right
local ticker = text(root, "MarketTicker", "GIEŁDA OTWARTA    /    Twoje wielkie imperium zaczyna się od jednego telefonu.", 11, C.gold, UDim2.fromOffset(22, 83), UDim2.new(1, -44, 0, 20))
ticker.TextTruncate = Enum.TextTruncate.AtEnd

local upgrade = make("Frame", {
    Name = "NextUpgrade", Position = UDim2.new(0, 18, 1, -237), Size = UDim2.fromOffset(306, 204),
    BackgroundColor3 = C.panel, BackgroundTransparency = 0.04, BorderSizePixel = 0,
}, root)
corner(upgrade, 13); stroke(upgrade)
local nextLabel = text(upgrade, "Caption", "NASTĘPNY RUCH / 01", 10, C.gold, UDim2.fromOffset(16, 12), UDim2.new(1, -32, 0, 17))
local nextName = text(upgrade, "Name", "Twoje pierwsze biuro", 19, C.white, UDim2.fromOffset(16, 34), UDim2.new(1, -32, 0, 28))
nextName.Font = Enum.Font.GothamBold; nextName.TextTruncate = Enum.TextTruncate.AtEnd
local nextDesc = text(upgrade, "Description", "Za chwilę zaczynamy.", 12, C.muted, UDim2.fromOffset(16, 65), UDim2.new(1, -32, 0, 32))
nextDesc.TextWrapped = true
local nextPrice = text(upgrade, "Price", "$0 / $140", 12, C.white, UDim2.fromOffset(16, 105), UDim2.new(1, -32, 0, 18))
local progressTrack = make("Frame", {BackgroundColor3 = C.raised, BorderSizePixel = 0, Position = UDim2.fromOffset(16, 130), Size = UDim2.new(1, -32, 0, 5)}, upgrade)
corner(progressTrack, 3)
local progressFill = make("Frame", {BackgroundColor3 = C.gold, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1)}, progressTrack)
corner(progressFill, 3)
local buy = button(upgrade, "KUP ULEPSZENIE  [B]", C.gold, UDim2.fromOffset(16, 149), UDim2.new(1, -32, 0, 39), function()
    if snapshot and not snapshot.nextUpgrade then openPanel("Prestige") else send("Buy") end
end)

local pitchFrame = make("Frame", {
    Name = "Deal", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -32),
    Size = UDim2.fromOffset(285, 112), BackgroundColor3 = C.bg, BackgroundTransparency = 0.05, BorderSizePixel = 0,
}, root)
corner(pitchFrame, 13); stroke(pitchFrame)
local comboText = text(pitchFrame, "Combo", "SPRZEDAŻ / PIERWSZY KONTRAKT", 10, C.lime, UDim2.fromOffset(14, 10), UDim2.new(1, -28, 0, 16))
local pitch = button(pitchFrame, "DOMKNIJ KONTRAKT  [F]", C.lime, UDim2.fromOffset(12, 34), UDim2.new(1, -24, 0, 47), function() send("Pitch") end)
pitch.TextSize = 14
local pitchHint = text(pitchFrame, "Hint", "Każdy telefon zbliża Cię do kolejnego piętra.", 10, C.muted, UDim2.fromOffset(14, 86), UDim2.new(1, -28, 0, 17))

local dock = make("Frame", {Name = "Dock", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 113), Size = UDim2.fromOffset(151, 238), BackgroundTransparency = 1}, root)
local dockButtons = {}
local entries = {
    {"Quest", "ZADANIA"}, {"Event", "RYNEK"}, {"Prestige", "PRESTIŻ"},
    {"Home", "MOJE BIURO  [H]"}, {"Daily", "BONUS DNIA"}, {"Help", "JAK GRAĆ"},
}
for index, entry in ipairs(entries) do
    local key = entry[1]
    local element = button(dock, entry[2], C.panel, UDim2.fromOffset(0, (index - 1) * 40), UDim2.fromOffset(151, 33), function()
        if key == "Home" then send("Home")
        elseif key == "Daily" then send("Daily")
        else openPanel(key) end
    end)
    stroke(element)
    element.TextSize = 11
    dockButtons[key] = element
end

local saveText = text(root, "SaveStatus", "Łączenie z biurem…", 10, C.muted, UDim2.new(0.5, -230, 1, -23), UDim2.fromOffset(460, 18))
saveText.TextXAlignment = Enum.TextXAlignment.Center
local tutorial = text(root, "Tutorial", "1. Domykaj kontrakty     2. Kupuj ulepszenia     3. Odblokuj nowe piętra", 12, C.white, UDim2.new(0.5, -280, 0, 114), UDim2.fromOffset(560, 25))
tutorial.TextXAlignment = Enum.TextXAlignment.Center

local shade = make("TextButton", {
    Name = "ModalShade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
    BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
    Visible = false, ZIndex = 20,
}, root)
local modal = make("Frame", {
    Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(468, 420), BackgroundColor3 = C.bg, BorderSizePixel = 0, ZIndex = 21,
}, shade)
corner(modal, 16); stroke(modal, C.gold)
local modalTitle = text(modal, "Title", "", 22, C.gold, UDim2.fromOffset(22, 15), UDim2.new(1, -80, 0, 34))
modalTitle.ZIndex = 22; modalTitle.Font = Enum.Font.GothamBold
modalTitle.TextTruncate = Enum.TextTruncate.AtEnd
local close = button(modal, "×", C.raised, UDim2.new(1, -51, 0, 17), UDim2.fromOffset(32, 32), function() openPanel(nil) end)
close.ZIndex = 22; close.TextSize = 24
local content = make("ScrollingFrame", {
    Name = "Content", Position = UDim2.fromOffset(22, 64), Size = UDim2.new(1, -44, 1, -80),
    BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
    ScrollBarImageColor3 = C.gold, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 22,
}, modal)
local list = make("UIListLayout", {Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder}, content)
make("UIPadding", {PaddingRight = UDim.new(0, 7), PaddingBottom = UDim.new(0, 10)}, content)
local eventCountdown
local lastPanelSignature
local function panelSignature(name, data)
    if not name then return nil end
    local parts = {}
    local function add(value)
        local encoded = tostring(value)
        parts[#parts + 1] = tostring(#encoded) .. ":" .. encoded
    end
    add(name)
    if not data then add("loading"); return table.concat(parts, "|") end
    if name == "Quest" then
        local quest = data.quest
        add(quest ~= nil)
        if quest then
            add(quest.title); add(quest.progress); add(quest.goal); add(quest.reward); add(quest.ready)
        end
    elseif name == "Event" then
        local event = data.event
        add(event ~= nil)
        if event then
            add(event.id); add(event.title); add(event.description); add(event.endsAt); add(event.choice)
            for _, option in ipairs(event.options or {}) do
                add(option.id); add(option.label); add(option.description)
            end
        end
    elseif name == "Prestige" then
        add(data.prestige); add(data.multiplier); add(data.level); add(data.prestigeReady)
    else
        add(data.saveStatus)
    end
    return table.concat(parts, "|")
end
local function paragraph(value, size, color, height)
    local label = text(content, "Paragraph", value, size or 14, color or C.white, UDim2.new(), UDim2.new(1, 0, 0, height or 56))
    label.TextWrapped = true; label.TextYAlignment = Enum.TextYAlignment.Top; label.ZIndex = 23
    return label
end
local function panelButton(label, callback, color, height)
    local result = button(content, label, color or C.raised, UDim2.new(), UDim2.new(1, 0, 0, height or 46), callback)
    result.TextWrapped = true; result.ZIndex = 23
    return result
end
local function clearContent()
    for _, item in ipairs(content:GetChildren()) do
        if not item:IsA("UIListLayout") and not item:IsA("UIPadding") then item:Destroy() end
    end
    eventCountdown = nil
end
local function drawPanel()
    lastPanelSignature = panelSignature(activePanel, snapshot)
    clearContent()
    if not activePanel then return end
    if not snapshot then
        modalTitle.Text = "OTWIERANIE BIURA"
        paragraph("Wczytujemy postęp. Za chwilę rozpocznie się Twoja sesja.")
        return
    end
    if activePanel == "Quest" then
        modalTitle.Text = "TWOJA NASTĘPNA WYGRANA"
        local quest = snapshot.quest
        if quest then
            paragraph(quest.title or "Rozwijaj imperium", 19, C.white, 57)
            paragraph("POSTĘP  " .. format(math.min(quest.progress or 0, quest.goal or 1)) .. " / " .. format(quest.goal or 1), 12, C.lime, 23)
            paragraph("Nagroda: " .. cash(quest.reward or 0), 22, C.gold, 36)
            panelButton(quest.ready and "ODBIERZ NAGRODĘ" or "WYKONUJ CEL, ABY ODEBRAĆ NAGRODĘ", function() send("Quest") end, quest.ready and C.lime or C.raised, 54)
            paragraph("Każde ukończone zadanie prowadzi do kolejnego celu. Rozbudowa pięter i domykanie kontraktów liczą się automatycznie.", 13, C.muted, 78)
        else
            paragraph("Wszystkie zadania ukończone. Imponujące imperium! Zdobądź Złotego Wilka i przejdź do prestiżu.", 17, C.white, 95)
        end
    elseif activePanel == "Event" then
        modalTitle.Text = "PULS WALL STREET"
        local event = snapshot.event
        if event then
            paragraph(event.title or "Sesja giełdowa", 20, C.white, 42)
            paragraph(event.description or "Dopasuj strategię biura do obecnego rynku.", 14, C.muted, 75)
            eventCountdown = paragraph("", 12, C.gold, 22)
            for _, option in ipairs(event.options or {}) do
                local id = option.id
                local selected = event.choice == id
                local label = (selected and "WYBRANO: " or "") .. (option.label or id)
                if option.description then label = label .. "\n" .. option.description end
                panelButton(label, function() send("Strategy", id) end, selected and C.lime or C.raised, 62)
            end
            paragraph("Wybór strategii nie kosztuje pieniędzy. Notowania na pasku budują klimat fikcyjnej giełdy.", 12, C.muted, 52)
        else paragraph("Rynek przygotowuje kolejne wydarzenie. W tym czasie rozbuduj biuro.", 16, C.white, 70) end
    elseif activePanel == "Prestige" then
        modalTitle.Text = "ZOSTAŃ LEGENDĄ"
        paragraph("PRESTIŻ  " .. format(snapshot.prestige or 0) .. "    /    MNOŻNIK  ×" .. string.format("%.2f", snapshot.multiplier or 1), 12, C.lime, 25)
        paragraph("Zbuduj imperium ponownie z trwałą premią +25% do zarobków za każdy prestiż.", 20, C.white, 83)
        paragraph("Reset wyzeruje gotówkę i wszystkie 18 ulepszeń biura. Zachowasz prestiż, tytuły i postęp zadań. Tę decyzję podejmujesz dopiero po kupieniu Złotego Wilka.", 14, C.muted, 112)
        panelButton(snapshot.prestigeReady and "POTWIERDZAM RESET I NOWY PRESTIŻ" or "NAJPIERW KUP ZŁOTEGO WILKA  /  18 Z 18", function()
            if snapshot and snapshot.prestigeReady then
                send("Prestige")
                openPanel(nil)
            end
        end, snapshot.prestigeReady and C.gold or C.raised, 55)
        panelButton("WRÓĆ DO IMPERIUM", function() openPanel(nil) end, C.raised, 39)
    else
        modalTitle.Text = "TWÓJ PIERWSZY MILION"
        paragraph("01  DOMYKAJ KONTRAKTY\nKlikaj zielony przycisk co 5 sekund. Utrzymuj serię, by zarabiać więcej.", 14, C.white, 72)
        paragraph("02  ROZBUDOWUJ BIURO\nKupuj kolejne ulepszenia. Pracownicy zarabiają automatycznie, gdy grasz. Po ulepszeniu 7 i 13 powstają nowe piętra.", 14, C.white, 91)
        paragraph("03  REAGUJ NA RYNEK\nOtwórz RYNEK, przeczytaj wiadomość i wybierz strategię. Odbieraj nagrody za zadania i bonus dnia.", 14, C.white, 80)
        paragraph("STEROWANIE\nKomputer: WASD — ruch, spacja — skok, E — obiekty w świecie, F — kontrakt, B — zakup, H — biuro. Telefon: joystick i przyciski ekranu. Windy w biurze przenoszą między piętrami.", 13, C.muted, 111)
        paragraph("ZAPIS\n" .. tostring(snapshot.saveStatus or "Sprawdzanie zapisu…"), 13, C.gold, 65)
        paragraph("To fikcyjny świat biznesu. Waluta i notowania służą wyłącznie rozgrywce.", 12, C.muted, 47)
    end
end
openPanel = function(name)
    if name == activePanel then name = nil end
    activePanel = name
    shade.Visible = name ~= nil
    content.CanvasPosition = Vector2.new()
    if name then drawPanel() end
end
shade.Activated:Connect(function() openPanel(nil) end)
-- The modal frame captures input so tapping inside it does not dismiss the shade.
modal.Active = true

local toast = make("Frame", {
    Name = "Notice", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 108),
    Size = UDim2.fromOffset(420, 62), BackgroundColor3 = C.panel, BorderSizePixel = 0, Visible = false, ZIndex = 40,
}, root)
corner(toast, 12); stroke(toast, C.gold)
local toastText = text(toast, "Message", "", 14, C.white, UDim2.fromOffset(16, 8), UDim2.new(1, -32, 1, -16))
toastText.TextWrapped = true; toastText.ZIndex = 41
local function showNotice(message, kind)
    toastNumber = toastNumber + 1
    local number = toastNumber
    toastText.Text = tostring(message)
    toastText.TextColor3 = (kind == "error" or kind == "warning") and C.red or ((kind == "success" or kind == "money" or kind == "cash") and C.lime or C.white)
    toast.Visible = true
    toast.BackgroundTransparency = 0.03
    toastText.TextTransparency = 0
    task.delay(3.7, function()
        if number ~= toastNumber then return end
        TweenService:Create(toast, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(toastText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        task.delay(0.3, function() if number == toastNumber then toast.Visible = false end end)
    end)
end

local function layout()
    local dimensions = root.AbsoluteSize
    viewWidth = math.max(320, dimensions.X)
    viewHeight = math.max(240, dimensions.Y)
    compact = viewWidth &lt; 850 or viewHeight &lt; 520
    top.Size = UDim2.new(1, -24, 0, compact and 60 or 66)
    brand.TextSize = compact and 15 or 19
    brand.Size = UDim2.fromOffset(compact and 144 or 210, 24)
    rank.Size = UDim2.fromOffset(compact and math.max(130, viewWidth - 215) or 320, 17)
    rank.TextTruncate = Enum.TextTruncate.AtEnd
    rank.TextSize = compact and 9 or 10
    money.Position = UDim2.new(1, compact and -173 or -265, 0, 8)
    money.Size = UDim2.fromOffset(compact and 157 or 245, 29)
    money.TextSize = compact and 21 or 25
    income.Position = UDim2.new(1, compact and -173 or -265, 0, 37)
    income.Size = UDim2.fromOffset(compact and 157 or 245, 19)
    income.TextSize = compact and 10 or 12
    ticker.Position = UDim2.fromOffset(18, compact and 75 or 83)
    ticker.TextSize = compact and 10 or 11
    local upgradeWidth = compact and math.max(175, math.min(240, viewWidth - 153)) or 306
    upgrade.Position = compact and UDim2.fromOffset(12, 104) or UDim2.new(0, 18, 1, -237)
    upgrade.Size = UDim2.fromOffset(upgradeWidth, compact and 160 or 204)
    nextLabel.Position = UDim2.fromOffset(12, compact and 8 or 12)
    nextName.Position = UDim2.fromOffset(12, compact and 27 or 34)
    nextName.Size = UDim2.new(1, -24, 0, compact and 25 or 28)
    nextName.TextSize = compact and 15 or 19
    nextDesc.Position = UDim2.fromOffset(12, compact and 55 or 65)
    nextDesc.Size = UDim2.new(1, -24, 0, compact and 28 or 32)
    nextDesc.TextSize = compact and 10 or 12
    nextPrice.Position = UDim2.fromOffset(12, compact and 85 or 105)
    nextPrice.TextSize = compact and 10 or 12
    progressTrack.Position = UDim2.fromOffset(12, compact and 108 or 130)
    progressTrack.Size = UDim2.new(1, -24, 0, 5)
    buy.Position = UDim2.fromOffset(12, compact and 120 or 149)
    buy.Size = UDim2.new(1, -24, 0, compact and 30 or 39)
    buy.TextSize = compact and 10 or 13
    local dockWidth = compact and 116 or 151
    dock.Size = UDim2.fromOffset(dockWidth, compact and 224 or 238)
    dock.Position = UDim2.new(1, compact and -12 or -18, 0, compact and 104 or 113)
    for index, entry in ipairs(entries) do
        local item = dockButtons[entry[1]]
        item.Size = UDim2.fromOffset(dockWidth, compact and 30 or 33)
        item.Position = UDim2.fromOffset(0, (index - 1) * (compact and 36 or 40))
        item.TextSize = compact and 9 or 11
    end
    local portrait = compact and viewWidth &lt; 560
    pitchFrame.AnchorPoint = compact and Vector2.new(0.5, 1) or Vector2.new(1, 1)
    pitchFrame.Position = compact and UDim2.new(0.5, portrait and 0 or (upgradeWidth - dockWidth) / 2, 1, portrait and -108 or -24) or UDim2.new(1, -18, 1, -32)
    pitchFrame.Size = UDim2.fromOffset(compact and 232 or 285, compact and 94 or 112)
    comboText.TextSize = compact and 9 or 10
    pitch.Position = UDim2.fromOffset(10, compact and 28 or 34)
    pitch.Size = UDim2.new(1, -20, 0, compact and 43 or 47)
    pitch.TextSize = compact and 12 or 14
    pitchHint.Position = UDim2.fromOffset(12, compact and 74 or 86)
    pitchHint.TextSize = compact and 8 or 10
    saveText.Visible = not compact
    tutorial.Visible = not compact and (not snapshot or (snapshot.level or 0) &lt; 3)
    modal.Size = UDim2.fromOffset(math.min(468, viewWidth - 28), math.min(460, viewHeight - 24))
    modalTitle.TextSize = compact and 16 or 22
    toast.Size = UDim2.fromOffset(math.min(420, viewWidth - 28), compact and 56 or 62)
    toast.Position = UDim2.new(0.5, 0, 0, compact and 102 or 108)
end
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
layout()

local function applyState(data)
    if type(data) ~= "table" then return end
    local initial = snapshot == nil
    snapshot = data
    if initial then displayedCash = data.cash or 0 end
    income.Text = "+" .. cash(data.income or 0) .. "/s  •  P" .. format(data.prestige or 0)
    rank.Text = string.upper(data.title or "Początkujący makler") .. "  /  " .. format(data.level or 0) .. "/" .. format(data.maxLevel or 18)
    local nextUpgrade = data.nextUpgrade
    if nextUpgrade then
        nextLabel.Text = "NASTĘPNY RUCH / " .. string.format("%02d", (data.level or 0) + 1) .. "  •  PIĘTRO " .. tostring(nextUpgrade.floor or 1)
        nextName.Text = nextUpgrade.name or "Ulepszenie"
        nextDesc.Text = (nextUpgrade.desc or "Rozwiń swoje biuro.") .. "  +" .. cash(nextUpgrade.income or 0) .. "/s"
        nextPrice.Text = cash(data.cash or 0) .. " / " .. cash(nextUpgrade.price or 1)
        local ratio = math.clamp((data.cash or 0) / math.max(1, nextUpgrade.price or 1), 0, 1)
        TweenService:Create(progressFill, TweenInfo.new(0.3), {Size = UDim2.fromScale(ratio, 1)}):Play()
        local affordable = (data.cash or 0) &gt;= (nextUpgrade.price or 1)
        buy.BackgroundColor3 = affordable and C.gold or C.raised
        buy.TextColor3 = affordable and C.bg or C.muted
        buy.Text = affordable and (compact and "KUP TERAZ" or "KUP ULEPSZENIE  [B]") or (compact and "ZBIERZ " .. cash((nextUpgrade.price or 0) - (data.cash or 0)) or "BRAKUJE " .. cash((nextUpgrade.price or 0) - (data.cash or 0)))
    else
        nextLabel.Text = "IMPERIUM UKOŃCZONE  /  18 Z 18"
        nextName.Text = "Złoty Wilk jest Twój"
        nextDesc.Text = "Otwórz PRESTIŻ i zacznij z trwałą premią."
        nextPrice.Text = "Następny cel: legenda Wall Street"
        progressFill.Size = UDim2.fromScale(1, 1)
        buy.Text = "OTWÓRZ PRESTIŻ"
        buy.BackgroundColor3 = C.gold; buy.TextColor3 = C.bg
    end
    dockButtons.Quest.Text = data.quest and data.quest.ready and "ODBIERZ ZADANIE!" or "ZADANIA"
    dockButtons.Quest.TextColor3 = data.quest and data.quest.ready and C.lime or C.white
    dockButtons.Daily.Text = data.dailyReady and "BONUS DNIA!" or "BONUS ODEBRANY"
    dockButtons.Daily.TextColor3 = data.dailyReady and C.gold or C.muted
    dockButtons.Prestige.TextColor3 = data.prestigeReady and C.gold or C.white
    local marketParts = {}
    for _, stock in ipairs(data.market or {}) do
        local delta = tonumber(stock.delta) or 0
        table.insert(marketParts, tostring(stock.ticker or "WOLF") .. " " .. string.format("%.1f", stock.value or 0) .. "  " .. (delta &gt;= 0 and "+" or "") .. string.format("%.1f%%", delta))
    end
    if #marketParts &gt; 0 then ticker.Text = "LIVE  /  " .. table.concat(marketParts, "     •     ") end
    saveText.Text = tostring(data.saveStatus or "Postęp jest zapisywany automatycznie.")
    tutorial.Visible = not compact and (data.level or 0) &lt; 3
    -- Frequent cash snapshots must not replace a button while a finger is pressing it.
    -- Countdown labels update independently in RenderStepped below.
    if activePanel and panelSignature(activePanel, data) ~= lastPanelSignature then
        local position = content.CanvasPosition
        drawPanel()
        content.CanvasPosition = position
    end
end

stateEvent.OnClientEvent:Connect(applyState)
noticeEvent.OnClientEvent:Connect(showNotice)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Escape and activePanel then openPanel(nil) return end
    if activePanel then return end
    if input.KeyCode == Enum.KeyCode.F then send("Pitch")
    elseif input.KeyCode == Enum.KeyCode.B then send("Buy")
    elseif input.KeyCode == Enum.KeyCode.H then send("Home") end
end)

local timer = 0
RunService.RenderStepped:Connect(function(dt)
    if not snapshot then return end
    displayedCash = displayedCash + ((snapshot.cash or 0) - displayedCash) * math.min(1, dt * 12)
    money.Text = cash(displayedCash)
    timer = timer + dt
    if timer &lt; 0.1 then return end
    timer = 0
    local now = serverNow()
    local remaining = math.max(0, (snapshot.pitchReadyAt or 0) - now)
    pitch.Text = remaining &gt; 0 and ("NASTĘPNY ZA " .. string.format("%.1f", remaining) .. " s") or ("DOMKNIJ KONTRAKT  +" .. cash(snapshot.pitchReward or 20))
    pitch.BackgroundColor3 = remaining &gt; 0 and C.raised or C.lime
    pitch.TextColor3 = remaining &gt; 0 and C.muted or C.bg
    local combo = snapshot.combo or 0
    local comboRemaining = math.max(0, (snapshot.comboExpires or 0) - now)
    comboText.Text = combo &gt; 0 and comboRemaining &gt; 0 and ("SERIA " .. format(combo) .. "  /  UTRZYMAJ RYTM: " .. math.ceil(comboRemaining) .. " s") or "KONTRAKTY / ROZPOCZNIJ SERIĘ"
    pitchHint.Text = remaining &gt; 0 and "Pracownicy zarabiają w tle." or "W swoim biurze • dotknij lub naciśnij F"
    if eventCountdown and snapshot.event then
        local eventRemaining = math.max(0, (snapshot.event.endsAt or 0) - now)
        eventCountdown.Text = "NOWA SYTUACJA RYNKOWA ZA " .. tostring(math.ceil(eventRemaining)) .. " s"
    end
end)

send("Sync")
task.spawn(function()
    for _ = 1, 20 do
        task.wait(3)
        if snapshot then return end
        send("Sync")
    end
    if not snapshot then showNotice("Biuro nadal się wczytuje. Sprawdź połączenie i uruchom ponownie sesję.", "warning") end
end)
